<UserControl
    x:Class="NINA.Plugin.TargetScheduler.Controls.PlanPreview.PlanPreviewerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ninactrl="clr-namespace:NINA.CustomControlLibrary;assembly=NINA.CustomControlLibrary"
    xmlns:pp="clr-namespace:NINA.Plugin.TargetScheduler.Controls.PlanPreview"
    xmlns:rules="clr-namespace:NINA.Plugin.TargetScheduler.Controls.ValidationRules"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Resources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Moon avoidance table: fixed column widths, so nothing gets squeezed to an unreadable sliver.
                Foreground must be set explicitly - applying an explicit Style to a TextBlock replaces NINA's
                implicit theme style, and without it the text falls back to black on a black background.
            -->
            <Style x:Key="MoonHeaderCell" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Margin" Value="0,0,8,3" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="MoonRowCell" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding HasTimeTonight}" Value="True">
                        <Setter Property="Foreground" Value="MediumSeaGreen" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsBlockedAllNight}" Value="True">
                        <Setter Property="Foreground" Value="IndianRed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding NeverImagable}" Value="True">
                        <Setter Property="FontStyle" Value="Italic" />
                        <Setter Property="Opacity" Value="0.6" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="MoonGroupSummaryStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsAllClear}" Value="True">
                        <Setter Property="Foreground" Value="MediumSeaGreen" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsAllBlocked}" Value="True">
                        <Setter Property="Foreground" Value="IndianRed" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsNotImagable}" Value="True">
                        <Setter Property="FontStyle" Value="Italic" />
                        <Setter Property="Opacity" Value="0.6" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <Border
            Margin="0,10,0,10"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
            <StackPanel>
                <TextBlock
                    Width="480"
                    Margin="15"
                    HorizontalAlignment="Left"
                    FontStyle="Italic"
                    Text="Previews are not meant to reflect the exact behavior of the sequence instruction. Please read the documentation (link above) to understand how a preview will differ from a real run."
                    TextWrapping="Wrap" />

                <Grid
                    Width="400"
                    Margin="5,5,5,10"
                    HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition MinHeight="25" />
                        <RowDefinition MinHeight="25" />
                        <RowDefinition MinHeight="25" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        MaxWidth="80"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="Date/Time" />
                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="1"
                        Orientation="Horizontal">
                        <DatePicker VerticalAlignment="Center" SelectedDate="{Binding PlanDate}" />
                        <TextBlock
                            Margin="5,0,3,0"
                            VerticalAlignment="Center"
                            Text="at" />
                        <TextBox
                            Width="30"
                            Margin="3,0,0,0"
                            VerticalAlignment="Center">
                            <TextBox.Text>
                                <Binding Path="PlanHours">
                                    <Binding.ValidationRules>
                                        <rules:IntRangeRule>
                                            <rules:IntRangeRule.ValidRange>
                                                <rules:IntRangeChecker Maximum="23" Minimum="0" />
                                            </rules:IntRangeRule.ValidRange>
                                        </rules:IntRangeRule>
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                        <TextBlock VerticalAlignment="Center" Text=":" />
                        <TextBox
                            Width="30"
                            Margin="3,0,0,0"
                            VerticalAlignment="Center">
                            <TextBox.Text>
                                <Binding Path="PlanMinutes">
                                    <Binding.ValidationRules>
                                        <rules:IntRangeRule>
                                            <rules:IntRangeRule.ValidRange>
                                                <rules:IntRangeChecker Maximum="59" Minimum="0" />
                                            </rules:IntRangeRule.ValidRange>
                                        </rules:IntRangeRule>
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                        <TextBlock VerticalAlignment="Center" Text=":" />
                        <TextBox
                            Width="30"
                            Margin="3,0,0,0"
                            VerticalAlignment="Center">
                            <TextBox.Text>
                                <Binding Path="PlanSeconds">
                                    <Binding.ValidationRules>
                                        <rules:IntRangeRule>
                                            <rules:IntRangeRule.ValidRange>
                                                <rules:IntRangeChecker Maximum="59" Minimum="0" />
                                            </rules:IntRangeRule.ValidRange>
                                        </rules:IntRangeRule>
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>

                        <Button
                            Width="25"
                            Height="25"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Right"
                            Command="{Binding SetNowCommand}"
                            Style="{StaticResource BackgroundButton}"
                            ToolTip="Set preview date/time to now"
                            ToolTipService.ShowOnDisabled="True">
                            <Grid>
                                <Path
                                    Margin="5"
                                    Data="{StaticResource SS_ClockSVG}"
                                    Fill="{StaticResource ButtonForegroundBrush}"
                                    Stretch="Uniform" />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        MaxWidth="80"
                        VerticalAlignment="Center"
                        FontWeight="Bold"
                        Text="Profile" />
                    <ComboBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Width="220"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        DisplayMemberPath="Value"
                        ItemsSource="{Binding ProfileChoices}"
                        SelectedValue="{Binding SelectedProfileId}"
                        SelectedValuePath="Key" />
                    <WrapPanel
                        Grid.Row="2"
                        Grid.Column="1"
                        Orientation="Horizontal">
                        <Button
                            Width="50"
                            Height="25"
                            Margin="0,3,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding PlanPreviewCommand}"
                            Content="Run"
                            ToolTip="Run the planner preview" />
                        <Button
                            Width="100"
                            Height="25"
                            Margin="4,3,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding PlanPreviewResultsCommand}"
                            Content="View Details"
                            ToolTip="View planner details" />
                        <Button
                            Width="70"
                            Height="25"
                            Margin="4,3,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding PlanInsightCommand}"
                            Content="Insight"
                            ToolTip="Build the scoring/eligibility timeline for this night" />
                        <Button
                            Width="120"
                            Height="25"
                            Margin="4,3,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding MoonAvoidanceCommand}"
                            Content="Moon Avoidance"
                            ToolTip="Show moon distance and avoidance details for every active target over this night" />
                        <Button
                            Width="120"
                            Height="25"
                            Margin="4,3,0,0"
                            HorizontalAlignment="Left"
                            Command="{Binding ExportInsightCommand}"
                            Content="Export for LLM"
                            ToolTip="Write the plan explanation (JSON + digest + prompt template) to disk" />
                    </WrapPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Grid Height="350" Visibility="{Binding TableLoading, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}">
            <ninactrl:LoadingControl
                MaxWidth="100"
                MaxHeight="100"
                Margin="0,30,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                LoadingImageBrush="{StaticResource PrimaryBrush}"
                Visibility="{Binding TableLoading, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}" />
        </Grid>

        <Border
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            Visibility="{Binding ShowPlanPreview, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}">
            <TreeView BorderThickness="0" ItemsSource="{Binding InstructionList}">
                <TreeView.Template>
                    <ControlTemplate>
                        <ScrollViewer Height="300" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </TreeView.Template>
                <TreeView.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{Binding Source={StaticResource ProfileService}, Path=ActiveProfile.ColorSchemaSettings.ColorSchema.ButtonBackgroundSelectedColor}" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{Binding Source={StaticResource ProfileService}, Path=ActiveProfile.ColorSchemaSettings.ColorSchema.ButtonBackgroundSelectedColor}" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="{Binding Source={StaticResource ProfileService}, Path=ActiveProfile.ColorSchemaSettings.ColorSchema.TertiaryBackgroundColor}" />
                    <Style TargetType="{x:Type TreeView}">
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="FontWeight" Value="ExtraLight" />
                                <Setter Property="FontStyle" Value="Italic" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <Style TargetType="{x:Type TreeViewItem}">
                        <Setter Property="Margin" Value="0,3,0,3" />
                    </Style>
                </TreeView.Resources>
            </TreeView>
        </Border>
        <Border
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            Visibility="{Binding ShowPlanPreviewResults, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}">
            <ScrollViewer Height="300" VerticalScrollBarVisibility="Auto">
                <TextBlock FontFamily="Courier New" Text="{Binding PlanPreviewResultsLog}" />
            </ScrollViewer>
        </Border>
        <Border
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            Visibility="{Binding ShowTimeline, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}">
            <pp:TimelineView Explanation="{Binding Explanation}" />
        </Border>

        <Border
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            Visibility="{Binding ShowMoonAvoidance, Converter={StaticResource BooleanToVisibilityCollapsedConverter}}">
            <StackPanel>
                <TextBlock
                    Margin="10,10,10,4"
                    FontWeight="Bold"
                    Text="{Binding MoonAvoidanceSummary}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="10,0,10,8"
                    FontStyle="Italic"
                    Text="Moon distance and margin are taken at the most favorable moment of the night for each exposure plan, over the times the target is above its horizon and within its twilight span. 'To Unblock' is the largest Moon Avoidance Separation the exposure template could use and still get some time tonight. Window times are accurate to 10 minutes."
                    TextWrapping="Wrap" />

                <ScrollViewer
                    Height="300"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl Margin="8,0,8,8" ItemsSource="{Binding MoonAvoidanceGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander Margin="0,2,0,2" IsExpanded="False">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                FontSize="13"
                                                FontWeight="Bold"
                                                Text="{Binding Label}" />
                                            <TextBlock
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource MoonGroupSummaryStyle}"
                                                Text="{Binding SummaryText}" />
                                        </StackPanel>
                                    </Expander.Header>

                                    <StackPanel Margin="22,4,0,10">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource MoonHeaderCell}" Text="Filter" Width="60" />
                                            <TextBlock Style="{StaticResource MoonHeaderCell}" Text="Avoidance" Width="230" />
                                            <TextBlock Style="{StaticResource MoonHeaderCell}" Text="Moon Sep" Width="80" />
                                            <TextBlock Style="{StaticResource MoonHeaderCell}" Text="Required" Width="80" />
                                            <TextBlock Style="{StaticResource MoonHeaderCell}" Text="Margin" Width="75" />
                                            <TextBlock Style="{StaticResource MoonHeaderCell}" Text="Available Tonight" Width="240" />
                                            <TextBlock Style="{StaticResource MoonHeaderCell}" Text="To Unblock" Width="185" />
                                        </StackPanel>

                                        <ItemsControl ItemsSource="{Binding Rows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,1,0,1" Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource MoonRowCell}" Text="{Binding FilterName}" Width="60" />
                                                        <TextBlock Style="{StaticResource MoonRowCell}" Text="{Binding AvoidanceSettings}" Width="230" />
                                                        <TextBlock Style="{StaticResource MoonRowCell}" Text="{Binding MoonSeparationText}" Width="80" />
                                                        <TextBlock Style="{StaticResource MoonRowCell}" Text="{Binding RequiredSeparationText}" Width="80" />
                                                        <TextBlock Style="{StaticResource MoonRowCell}" Text="{Binding MarginText}" Width="75" />
                                                        <TextBlock Style="{StaticResource MoonRowCell}" Text="{Binding ClearWindowText}" Width="240" />
                                                        <TextBlock Style="{StaticResource MoonRowCell}" Text="{Binding SuggestionText}" Width="185" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>