<UserControl
    x:Class="NINA.Plugin.TargetScheduler.Controls.PlanPreview.TimelineView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary Source="../Resources/Resources.xaml" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Legend -->
        <WrapPanel
            x:Name="LegendPanel"
            Grid.Row="0"
            Margin="8,6,8,2"
            Orientation="Horizontal" />

        <!-- Timeline canvas -->
        <Border
            Grid.Row="1"
            Margin="8,2,8,2"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
            <ScrollViewer
                x:Name="TimelineScroller"
                Height="380"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto">
                <Canvas
                    x:Name="TimelineCanvas"
                    Background="Transparent"
                    ClipToBounds="False" />
            </ScrollViewer>
        </Border>

        <!-- Decision detail -->
        <Grid Grid.Row="2" Margin="8,4,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                x:Name="DecisionLabel"
                Grid.Row="0"
                Margin="0,2,0,4"
                FontWeight="Bold"
                Text="Click a target-switch marker (▼) on the timeline to see why that target was chosen over the others."
                TextWrapping="Wrap" />

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <DataGrid
                    x:Name="CandidatesGrid"
                    Grid.Column="0"
                    Margin="0,0,4,0"
                    MaxHeight="240"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Target}"
                            Header="Candidate" />
                        <DataGridTextColumn
                            Width="Auto"
                            Binding="{Binding Status}"
                            Header="Status / reason" />
                        <DataGridTextColumn
                            Width="Auto"
                            Binding="{Binding Score}"
                            Header="Score" />
                    </DataGrid.Columns>
                </DataGrid>

                <DataGrid
                    x:Name="RulesGrid"
                    Grid.Column="1"
                    Margin="4,0,0,0"
                    MaxHeight="240"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    HeadersVisibility="Column"
                    IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Rule}"
                            Header="Scoring rule" />
                        <DataGridTextColumn
                            Width="Auto"
                            Binding="{Binding Raw}"
                            Header="Raw" />
                        <DataGridTextColumn
                            Width="Auto"
                            Binding="{Binding Weight}"
                            Header="Weight" />
                        <DataGridTextColumn
                            Width="Auto"
                            Binding="{Binding Contribution}"
                            Header="Contribution" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
